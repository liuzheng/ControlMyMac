<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Per-user, loopback-only Apache Airflow supervisor. Generated values are resolved by install.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.liuzheng.controlmymac.airflow</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SUPERVISOR__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CONTROLMYMAC_AIRFLOW_HOME</key>
        <string>__AIRFLOW_HOME__</string>
        <key>CONTROLMYMAC_AIRFLOW_DAGS</key>
        <string>__DAGS_DIR__</string>
        <key>CONTROLMYMAC_AIRFLOW_LOG_ROOT</key>
        <string>__LOG_ROOT__</string>
        <key>CONTROLMYMAC_PYTHON_PACKAGES</key>
        <string>__PYTHON_PACKAGES__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin</string>
        <key>PYTHONNOUSERSITE</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__SERVICE_LOG__/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__SERVICE_LOG__/stderr.log</string>
</dict>
</plist>
